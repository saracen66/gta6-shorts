# Copy to .env and fill in. Never commit .env.

# Claude (judge). Or leave empty and use `ant auth login`.
ANTHROPIC_API_KEY=

# Twitch app (https://dev.twitch.tv/console/apps) - client credentials, no user login needed
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick app (https://kick.com/settings/developer) - client credentials
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# YouTube Data API key for search (Google Cloud console). Upload uses OAuth: secrets/youtube_client_secret.json
YOUTUBE_API_KEY=

# Meta: long-lived PAGE access token with pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish. IG account must be Business/Creator linked to the Page.
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=

# TikTok developer app (https://developers.tiktok.com) with Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/callback
